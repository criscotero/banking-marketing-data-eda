# Copy to `.env` and adjust. Nothing here is required: the project runs end to
# end with no environment variables at all, against a public dataset and with
# file-based tracking. `.env` is gitignored.
#
# There are no credentials in this project because there is nothing to
# authenticate against. If the inference path is ever fronted by an API or wired
# to a CRM, the secrets for that belong here — never in configs/ or in code.

# --------------------------------------------------------------------------- #
# Paths
# --------------------------------------------------------------------------- #

# Repository root used to resolve the relative paths in configs/base.yaml.
# Set this when running from a different working directory (a scheduler, a
# container with a bind mount elsewhere).
# TERM_DEPOSIT_ROOT=/app

# --------------------------------------------------------------------------- #
# Logging
# --------------------------------------------------------------------------- #

# Overrides `log_level` from the config files. DEBUG is useful when diagnosing a
# split or a calibration step.
# TERM_DEPOSIT_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Experiment tracking (optional)
# --------------------------------------------------------------------------- #

# The default backend is `jsonl`, which writes to reports/metrics/ and needs
# nothing else. To use MLflow instead:
#   uv sync --extra mlflow
#   uv run python scripts/train.py --set tracking.backend=mlflow
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_EXPERIMENT_NAME=term-deposit-propensity

# --------------------------------------------------------------------------- #
# Reproducibility
# --------------------------------------------------------------------------- #

# Pin BLAS threads to make float reductions bit-reproducible across machines.
# Slower; used when verifying that two runs produce identical metrics.
# OMP_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
