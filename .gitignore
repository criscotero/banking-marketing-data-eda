# --------------------------------------------------------------------------- #
# Data
# --------------------------------------------------------------------------- #
# The dataset is public and reproducible: `scripts/prepare_data.py` downloads it
# and verifies a SHA-256 checksum. Committing it would put a binary blob in the
# history for no reproducibility gain. See ADR 0001.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/README.md

# --------------------------------------------------------------------------- #
# Generated outputs
# --------------------------------------------------------------------------- #
# Model binaries and metric documents are outputs, not sources. Every one of them
# is regenerated by `make train`, and their provenance lives in metadata.json.
artifacts/*
!artifacts/README.md
!artifacts/.gitkeep

reports/figures/*
reports/metrics/*
!reports/**/.gitkeep
!reports/README.md

mlruns/
mlflow.db

# --------------------------------------------------------------------------- #
# Secrets and local configuration
# --------------------------------------------------------------------------- #
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# --------------------------------------------------------------------------- #
# Take-home assessment material
# --------------------------------------------------------------------------- #
# The original brief belongs to the organisation that issued it and is not the
# author's to redistribute. Kept locally, never published.
private/

# --------------------------------------------------------------------------- #
# Python
# --------------------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version.local

# --------------------------------------------------------------------------- #
# Tooling caches
# --------------------------------------------------------------------------- #
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# --------------------------------------------------------------------------- #
# Notebooks
# --------------------------------------------------------------------------- #
.ipynb_checkpoints/
# Notebook outputs are stripped by pre-commit before commit; see
# .pre-commit-config.yaml and notebooks/README.md.

# --------------------------------------------------------------------------- #
# Editors and operating systems
# --------------------------------------------------------------------------- #
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*~
